<%- include('../layout/header'); -%>

<div class="contenedor-formulario">

    <h1>Editar autor</h1>

    <form class="formulario" action="/autores/editar/<%= autor.id %>" method="POST">

        <label for="nombre">Nombre:</label>
        <input type="text" id="nombre" name="nombre" value="<%= autor.nombre %>" required>

        <label for="nacionalidad">Nacionalidad:</label>
        <input type="text" id="nacionalidad" name="nacionalidad" value="<%= autor.nacionalidad %>" required>

        <label for="fecha_nacimiento">Fecha de nacimiento:</label>
        <input type="date" id="fecha_nacimiento" name="fecha_nacimiento" value="<%= autor.fechaNacimiento %>" required>

        <button type="submit">Guardar autor</button>

    </form>

    <a href="/autores" class="btn-volver">← Volver a la lista</a>

</div>

<%- include('../layout/footer'); -%>