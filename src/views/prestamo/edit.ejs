<%- include('../layout/header'); -%>

<h2>Editar préstamo #<%= prestamo.id %>:</h2>
<form action="/prestamo/<%= prestamo.id %>/edit" method="post">
    <label for="usuario_id">Usuario</label>
    <select name="usuario_id" id="usuario_id" required>
        <% for (const usuario of usuarios) { %>
            <option value="<%= usuario.id %>" <%= usuario.id === prestamo.usuario_id ? "selected" : "" %>>
                <%= usuario.nombre %> <%= usuario.apellidos %>
            </option>
        <% } %>
    </select>

    <label for="libro_id">Libro</label>
    <select name="libro_id" id="libro_id" required>
        <% for (const libro of libros) { %>
            <option value="<%= libro.id %>" <%= libro.id === prestamo.libro_id ? "selected" : "" %>>
                <%= libro.titulo %>
            </option>
        <% } %>
    </select>

    <label for="fecha_prestamo">Fecha de préstamo</label>
    <input type="date" name="fecha_prestamo" id="fecha_prestamo" value="<%= prestamo.fecha_prestamo %>" required>

    <label for="fecha_devolucion">Fecha de devolución</label>
    <input type="date" name="fecha_devolucion" id="fecha_devolucion" value="<%= prestamo.fecha_devolucion || '' %>">

    <button>Guardar</button>
</form>
<a href="/prestamo/<%= prestamo.id %>">Volver</a>
<%- include('../layout/footer'); -%>
