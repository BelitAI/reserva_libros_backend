<%- include('../layout/header'); -%>

<h1>Lista de préstamos</h1>

<a href="/prestamo/new">+ Nuevo préstamo</a>

<% if (prestamos && prestamos.length > 0) { %>
    <table border="1">
        <thead>
            <tr>
                <th>ID</th>
                <th>Usuario</th>
                <th>Libro</th>
                <th>Fecha de préstamo</th>
                <th>Fecha de devolución</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            <% prestamos.forEach(prestamo => { %>
                <tr>
                    <td><%= prestamo.id %></td>
                    <td><%= prestamo.usuario ? prestamo.usuario.nombre + " " + prestamo.usuario.apellidos : "Desconocido" %></td>
                    <td><%= prestamo.libro ? prestamo.libro.titulo : "Desconocido" %></td>
                    <td><%= prestamo.fechaPrestamo %></td>
                    <td><%= prestamo.fechaDevolucion || 'Pendiente' %></td>
                    <td><a href="/prestamo/<%= prestamo.id %>">Ver</a></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
<% } else { %>
    <p>No hay préstamos registrados.</p>
<% } %>

<%- include('../layout/footer'); -%>
