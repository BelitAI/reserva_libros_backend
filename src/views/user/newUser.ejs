<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nuevo usuario</title>
</head>

<body>

    <h1>Crear nuevo usuario</h1>
    <p>Introduce tus datos para registrarte.</p>

    <form action="/user/new" method="POST">

        <div>
            <label for="nombre">Nombre:</label>
            <input type="text" id="nombre" name="nombre" placeholder="Introduce tu nombre" required>
        </div>

        <br>

        <div>
            <label for="apellidos">Apellidos:</label>
            <input type="text" id="apellidos" name="apellidos" placeholder="Introduce tus apellidos" required>
        </div>

        <br>

        <div>
            <label for="mail">Correo electrónico:</label>
            <input type="email" id="mail" name="mail" placeholder="ejemplo@email.com" required>
        </div>

        <br>

        <div>
            <label for="contrasena">Contraseña:</label>
            <input type="password" id="contrasena" name="contrasena" placeholder="Introduce tu contraseña" required>
        </div>

        <br>

        <button type="submit">Crear usuario</button>

    </form>

    <p>
        ¿Ya tienes cuenta?
        <a href="/user/login">Iniciar sesión</a>
    </p>

</body>

</html>