<%- include('../layout/header'); -%>
    <div class="container">

        <h1>Lista de usuarios</h1>

        <a href="/user/new">+ Nuevo usuario</a>

        <table>

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Apellidos</th>
                    <th>Email</th>
                    <th>Eliminar</th>
                </tr>
            </thead>

            <tbody>

                <% usuarios.forEach(usuario=> { %>

                    <tr>
                        <td>
                            <%= usuario.id %>
                        </td>
                        <td>
                            <%= usuario.nombre %>
                        </td>
                        <td>
                            <%= usuario.apellidos %>
                        </td>
                        <td>
                            <%= usuario.mail %>
                        </td>

                        <td>
                            <form action="/user/<%= usuario.id %>/delete" method="POST">
                                <button type="submit">X</button>
                            </form>
                        </td>
                        <td>
                            <form action="/user/<%= usuario.id %>" method="GET">
                                <button type="submit">Ver</button>
                            </form>
                        </td>
                    </tr>

                    <% }) %>

            </tbody>

        </table>

    </div>
    <%- include('../layout/footer'); -%>