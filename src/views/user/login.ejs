<%- include('../layout/header'); -%>

<div class="loginContainer">

    <div class="login">

        <h1>Iniciar sesión</h1>
        <p class="login-descripcion">Introduce tus datos para acceder</p>

        <form action="/user/login" method="POST" class="formulario-login">

            <div>
                <label for="email">Correo electrónico:</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="ejemplo@email.com"
                    required>
            </div>

            <div>
                <label for="password">Contraseña:</label>
                <input
                    type="password"
                    id="password"
                    name="password"
                    placeholder="Introduce tu contraseña"
                    required>
            </div>

            <button type="submit">Iniciar sesión</button>

        </form>

        <p class="login-registro">
            ¿No tienes cuenta?
            <a href="/user/new">Regístrate aquí</a>
        </p>

    </div>
    <%- include('../layout/footer'); -%>
