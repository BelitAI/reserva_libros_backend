<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Datos del usuario</title>
</head>

<body>

    <h1>Datos del usuario</h1>

    <p><strong>ID:</strong>
        <%= usuario.id %>
    </p>
    <p><strong>Nombre:</strong>
        <%= usuario.nombre %>
    </p>
    <p><strong>Apellidos:</strong>
        <%= usuario.apellidos %>
    </p>
    <p><strong>Email:</strong>
        <%= usuario.mail %>
    </p>
    <p><strong>Administrador:</strong>
        <%= usuario.es_admin ? "Sí" : "No" %>
    </p>

    <h2>Pedidos</h2>
    <table border="1">
        <thead>
            <tr>
                <th>Libro</th>
                <th>Autor</th>
                <th>Fecha de préstamo</th>
                <th>Fecha de devolución</th>
            </tr>
        </thead>
        <tbody>
            <% usuario.prestamos.forEach(prestamo=> { %>
                <tr>
                    <td><%= prestamo.libro.titulo %></td>
                    <td><%= prestamo.libro.autor.nombre %></td>
                    <td><%= prestamo.fechaPrestamo %></td>
                    <td><%= prestamo.fechaDevolucion===null ? "Sin devolución" : prestamo.fechaVencimiento %></td>
                </tr>
                <% }) %>
        </tbody>
    </table>
    <a href="/user/">Volver a usuarios</a>

</body>

</html>