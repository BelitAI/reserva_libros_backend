<%- include('../layout/header') %>

<h2>Editar libro</h2>

<% if (libro) { %>
    <form action="/libro/<%= libro.id %>/edit" method="post">
        <label for="titulo">Título</label>
        <input type="text" id="titulo" name="titulo"
               value="<%= libro.titulo %>" required>

        <label for="autor_id">Identificador del autor</label>
        <input type="number" id="autor_id" name="autor_id"
               value="<%= libro.autor_id %>" min="1" required>

        <label for="genero">Género</label>
        <input type="text" id="genero" name="genero"
               value="<%= libro.genero ?? '' %>">

        <button type="submit">Guardar cambios</button>
    </form>
<% } else { %>
    <p>No existe el libro.</p>
<% } %>
<a href="/libro">Volver a los libros</a>
<%- include('../layout/footer') %>