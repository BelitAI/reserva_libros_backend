<%- include('../layout/header') %>

    <link rel="stylesheet" href="/css/libros.css">

    <section class="libros-page">

        <% if (mensaje) { %>

            <div class="<%= mensaje.includes('correctamente') ? 'mensaje-exito' : 'mensaje-aviso' %>">
                <%= mensaje %>
            </div>

            <% } %>
                <h2>Libros</h2>
               <% if (user && user.role === true) { %>
                <a href="/libro/new" class="libros-boton">Crear libro</a>
                <% } %>
                    <div class="libros-grid">
                        <% for (const libro of libros) { %>
                            <%- include('libroCard', { libro }) %>
                                <% } %>
                    </div>
    </section>

    <%- include('../layout/footer') %>